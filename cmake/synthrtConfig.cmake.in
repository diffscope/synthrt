@PACKAGE_INIT@

# synthrt - DiffSinger synthesis runtime
# find_package(synthrt) provides the srt::diffsinger aggregate target
# which links: srt::g2p, srt-ds::bank, srt-ds::infer, srt-ds::session

include(CMakeFindDependencyMacro)

# Find all sub-package configs exported by qm_add_library
find_dependency(srt-core)
find_dependency(srt-driver)
find_dependency(srt-g2p)
find_dependency(srt-ds-bank)
find_dependency(srt-ds-infer)
find_dependency(srt-ds-session)

include("${CMAKE_CURRENT_LIST_DIR}/synthrtTargets.cmake")

check_required_components(synthrt)
