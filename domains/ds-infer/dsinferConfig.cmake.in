@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(srt-core)
find_dependency(srt-driver)
find_dependency(srt-s2p)
find_dependency(srt-svs)
find_dependency(srt-ds-bank)

include("${CMAKE_CURRENT_LIST_DIR}/dsinferTargets.cmake")

if(NOT TARGET dsinfer::dsinfer AND TARGET dsinfer::srt-ds-infer)
    add_library(dsinfer::dsinfer INTERFACE IMPORTED)
    target_link_libraries(dsinfer::dsinfer INTERFACE dsinfer::srt-ds-infer)
    set_target_properties(dsinfer::dsinfer PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "$<TARGET_PROPERTY:dsinfer::srt-ds-infer,INTERFACE_INCLUDE_DIRECTORIES>"
    )
endif()

check_required_components(dsinfer)
