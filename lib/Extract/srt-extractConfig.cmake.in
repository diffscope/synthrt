@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(stdcorelib)
find_dependency(srt-core)
find_dependency(srt-audio)
find_dependency(srt-driver)

include("${CMAKE_CURRENT_LIST_DIR}/srt-extractTargets.cmake")

# Convenience alias: srt::extract -> srt-extract::srt-extract
# Allows consumers to use the short srt:: namespace consistently.
if(TARGET srt-extract::srt-extract AND NOT TARGET srt::extract)
    add_library(srt::extract INTERFACE IMPORTED)
    set_target_properties(srt::extract PROPERTIES
        INTERFACE_LINK_LIBRARIES "srt-extract::srt-extract"
    )
endif()

check_required_components(srt-extract)
