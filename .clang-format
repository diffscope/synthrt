BasedOnStyle: LLVM
Standard: c++20
Language: Cpp

# 缩进与宽度
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
ContinuationIndentWidth: 4

# 指针与引用
PointerAlignment: Right
ReferenceAlignment: Right

# 大括号（保持 LLVM 默认，不切 Allman — Q8 决策方案 A）
BreakBeforeBraces: Attach

# 函数/语句单行
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty
AllowShortLambdasOnASingleLine: Inline

# 对齐
AlignAfterOpenBracket: Align
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: true
AlignArrayOfStructures: Left
AlignEscapedNewlines: Left
AlignOperands: Align
AlignTrailingComments: true

# 空行（修复 CF-01）
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
# 注：EmptyLineBeforeAccessModifier 见下方"访问修饰符"段（避免重复键）

# include（修复 CF-02 / CF-05）
# 注意：IncludeBlocks: Regroup 会尝试重组所有 include 语句，包括 extern "C" {} 块内的。
#       FFmpeg/libav 等 C 第三方头必须置于 extern "C" {} 内，为避免 clang-format
#       误移动 include 出 extern "C" 块，相关文件须用 // clang-format off/on 包裹
#       （详见 §6.3 强制规则 3）。IncludeCategories 的 regex 仅用于"自由 include"
#       分组，不适用于 extern "C" {} 内的 include。
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<.*\.h>'
    Priority: 1
  - Regex: '^<.*>'
    Priority: 2
  - Regex: '^<(stdcorelib|nlohmann|onnxruntime|sparsepp)/'
    Priority: 3
  - Regex: '^<re2/re2\.h>'
    Priority: 3
  - Regex: '^<blake3\.h>|^<blake3_h\.h>'
    Priority: 3
  - Regex: '^<sndfile\.h>|^<sndfile\.hpp>'
    Priority: 3
  - Regex: '^<onnxruntime_cxx_api\.h>|^<onnxruntime_cxx_inline\.h>'
    Priority: 3
  - Regex: '^<(lua|luajit|lauxlib|lualib)\.h>'
    Priority: 3
  - Regex: '^<synthrt/'
    Priority: 4
  - Regex: '^<diffsinger/'
    Priority: 5
  - Regex: '^".*_p\.h"'
    Priority: 6
  - Regex: '^".*\.h"'
    Priority: 7

# namespace（修复 CF-03）
NamespaceIndentation: All
FixNamespaceComments: true
CompactNamespaces: false

# 大括号初始化
Cpp11BracedListStyle: true

# 模板
AlwaysBreakTemplateDeclarations: Yes
PackConstructorInitializers: NextLine

# 访问修饰符
AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: LogicalBlock

# case 标签
IndentCaseLabels: true
IndentCaseBlocks: false

# 预处理
IndentPPDirectives: AfterHash
PPIndentWidth: 2

# 杂项
SpacesInParentheses: false
SpacesInSquareBrackets: false
SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceAroundPointerQualifiers: Default
SpacesInContainerLiterals: false
IndentWrappedFunctionNames: true
AllowAllParametersOfDeclarationOnNextLine: false
ReflowComments: true

# 宏
StatementMacros: ['__qas_attr__', '__qas_exclude__', '__qas_include__']
ForEachMacros: [foreach, Q_FOREACH, BOOST_FOREACH, forever, Q_FOREVER, QBENCHMARK, QBENCHMARK_ONCE]

# 排序
SortUsingDeclarations: true
