# 由 ffmpeg-builds 端口生成。master 线的版本号形如 N-125365-g9a01c1cb6a，
# 不是数字版本，这时一律按「不做版本匹配」处理。
set(PACKAGE_VERSION "@FF_VERSION@")

if(NOT PACKAGE_VERSION MATCHES "^[0-9]+(\\.[0-9]+)*$")
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  set(PACKAGE_VERSION_EXACT FALSE)
elseif(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
