{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "builtin-baseline": "97b19caab97ab0c8d36c93230046c8c45fcd41d0",
    "dependencies": [
        "qmsetup",
        "nlohmann-json",
        "stduuid",
        "stdcorelib",
        "blake3",
        "sparsepp",
        "bit7z",
        "luajit",
        "re2",
        "cpp-pinyin",
        "syscmdline",
        {
            "name": "ffmpeg",
            "default-features": false,
            "features": ["avcodec", "avformat", "swresample"]
        },
        "libsndfile"
    ],
    "features": {
        "tests": {
            "description": "Enable test cases support",
            "dependencies": [
                { "name": "catch2", "version>=": "3.4.0" }
            ]
        }
    },
    "configuration": {
        "overlay-ports": [
            "../vcpkg/ports"
        ],
        "overlay-triplets": [
            "../vcpkg/triplets"
        ]
    }
}