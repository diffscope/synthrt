{
  "model_name": "0704_baseline",
  "binary_dir": "cache/dicts",
  "model": {
    "hidden_dim": 384,
    "num_layers": 2,
    "num_heads": 4,
    "ffn_dim": 768,
    "dropout": 0.1,
    "embed_dropout": 0.1,
    "max_phoneme_len": 48,
    "tie_decoder_embedding": false
  },
  "training": {
    "max_epochs": 100,
    "batch_size": 480,
    "num_workers": 0,
    "learning_rate": 0.003,
    "label_smoothing": 0.08,
    "gradient_clip_val": 1.0,
    "gradient_clip_algorithm": "norm",
    "val_check_interval": 1.0,
    "accelerator": "auto",
    "devices": "auto",
    "precision": "32-true",
    "data_device": "auto",
    "early_stopping_patience": 8,
    "optimizer": {
      "type": "adamw",
      "weight_decay": 0.0001,
      "betas": [
        0.9,
        0.98
      ],
      "muon_weight_decay": 0.1,
      "adamw_lr_scale": 10.0,
      "adamw_weight_decay": 0.0001,
      "momentum": 0.95,
      "nesterov": true,
      "ns_steps": 5
    },
    "lr_scheduler": {
      "type": "reduce_on_plateau",
      "mode": "max",
      "factor": 0.5,
      "patience": 8,
      "monitor": "val/seq_acc"
    },
    "checkpoint": {
      "recent_top_k": 3,
      "monitor_top_k": 3,
      "monitor_metric": "val/seq_acc"
    },
    "sampler": {
      "enabled": true,
      "strategy": "sqrt_freq"
    },
    "qat": {
      "enabled": false,
      "finetune_epochs": 3
    },
    "swa": {
      "enabled": false,
      "swa_lrs": 0.0015,
      "swa_epoch_start": 0.75
    }
  },
  "metrics": {
    "save_json": true,
    "save_report": true
  },
  "development": {
    "eval_per_on_end": false,
    "save_final_weights_only": true
  },
  "inference": {
    "default_beam_size": 1,
    "default_top_k": 1,
    "default_max_len": 48,
    "beam_kv_cache": true,
    "ensure_diverse_phonemes": true,
    "length_penalty": 0.0
  },
  "special_symbols": [
    "<unk>",
    "<pad>",
    "<bos>",
    "<eos>"
  ],
  "languages": [
    "eng/default",
    "deu/default",
    "fra/default",
    "ita/default",
    "kor/default",
    "por/default",
    "rus/default",
    "spa/default",
    "fil/default",
    "eng/plus",
    "deu/marzipan",
    "fra/millefeuille"
  ],
