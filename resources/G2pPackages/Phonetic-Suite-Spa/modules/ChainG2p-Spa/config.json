{
  "$version": "1.0",
  "level": 1,
  "mode": "standard",
  "schema": {},
  "configuration": {
    "steps": [
      {
        "step": "tagAndValidate",
        "params": {
          "tagger": [
            {
              "type": "regex",
              "value": [
                "(.+)"
              ],
              "tag": "all",
              "action": "convert"
            }
          ]
        }
      },
      {
        "step": "dict",
        "params": {
          "enabled": true,
          "file": "spa_dict.txt"
        }
      },
      {
        "step": "format",
        "params": {
          "cleaner": {
            "operations": [
              "lowercase"
            ]
          }
        }
      },
      {
        "step": "dict",
        "params": {
          "enabled": true,
          "file": "spa_dict.txt"
        }
      },
      {
        "step": "model",
        "params": {
          "enabled": true,
          "id": "g2p-multig2p-multi-official",
          "langRef": "spa/default",
          "batchSize": 20
        }
      },
      {
        "step": "fallback",
        "params": {
          "useOriginal": true,
          "markFailed": true
        }
      }
    ]
  }
}